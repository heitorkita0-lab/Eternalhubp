-- ====================================================================
-- LOOPS PRINCIPAIS
-- ====================================================================
RunService.RenderStepped:Connect(function()
    if not RootPart or not RootPart.Parent or not Humanoid then return end
    
    UpdateReachSphere()
    
    local ball = GetClosestBall()
    UpdateBallESP(ball)
    UpdatePlayerESP()

    -- LÓGICA SILENT AIM
    if SilentAimEnabled and ball and ball:IsA("BasePart") then
        local currentVel = ball.AssemblyLinearVelocity
        local speed = currentVel.Magnitude

        if speed > 15 then
            local targetGoal = ManualGoalPos
            if not targetGoal then
                local distA = (RootPart.Position - GoalA_Pos).Magnitude
                local distB = (RootPart.Position - GoalB_Pos).Magnitude
                targetGoal = distA > distB and GoalA_Pos or GoalB_Pos
            end

            local ballPos = ball.Position
            local goalVector = (targetGoal - ballPos)
            local distToGoal = goalVector.Magnitude

            if distToGoal > 4 then
                local targetDir = goalVector.Unit
                local currentY = currentVel.Y
                local desiredHorizontalDir = Vector3.new(targetDir.X, 0, targetDir.Z).Unit
                local currentHorizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)
                local currentHorizontalSpeed = currentHorizontalVel.Magnitude

                if currentHorizontalSpeed > 5 then
                    local blendedHorizontal = currentHorizontalVel.Unit:Lerp(desiredHorizontalDir, SilentAimCurve) * currentHorizontalSpeed
                    ball.AssemblyLinearVelocity = Vector3.new(blendedHorizontal.X, currentY, blendedHorizontal.Z)

                    local spinAxis = Vector3.new(0, 1, 0):Cross(blendedHorizontal.Unit)
                    ball.AssemblyAngularVelocity = ball.AssemblyAngularVelocity:Lerp(spinAxis * (currentHorizontalSpeed * 0.7), 0.1)
                end
            end
        end
    end

    -- LÓGICA AUTO CATCH
    if AutoCatchEnabled and ball then
        local ballDist = (ball.Position - RootPart.Position).Magnitude
        if ballDist <= AutoCatchDistance then
            local catchHand = Character:FindFirstChild("RightHand") 
                or Character:FindFirstChild("Right Arm") 
                or Character:FindFirstChild("LeftHand") 
                or Character:FindFirstChild("Left Arm") 
                or RootPart

            pcall(function()
                if ball:IsA("BasePart") then
                    ball.AssemblyLinearVelocity = Vector3.zero
                    ball.AssemblyAngularVelocity = Vector3.zero
                end
                ball.CFrame = catchHand.CFrame * CFrame.new(0, -0.2, -0.5)
            end)

            firetouchinterest(catchHand, ball, 0)
            firetouchinterest(catchHand, ball, 1)

            if AirCatchEnabled and (ball.Position.Y - RootPart.Position.Y) > 2.5 then
                if Humanoid.FloorMaterial ~= Enum.Material.Air then
                    Humanoid.Jump = true
                end
            end
        end
    end

    if AutoFollowEnabled and ball then
        local manualMove = IsManualMoving()
        local doingSkill = IsSkillPlaying()

        if not manualMove and not doingSkill then
            local ballPos = ball.Position
            local myPos = RootPart.Position
            local targetVector = Vector3.new(ballPos.X, myPos.Y, ballPos.Z)
            local distance = (targetVector - myPos).Magnitude

            if distance > FollowDistance then
                local moveDirection = (targetVector - myPos).Unit
                Humanoid:Move(moveDirection, false)
            end
        end
    end

    if ReachEnabled and ball and not IsSkillPlaying() then
        local distance = (ball.Position - RootPart.Position).Magnitude

        if distance <= ReachDistance then
            firetouchinterest(RootPart, ball, 0)
            firetouchinterest(RootPart, ball, 1)

            local lf = Character:FindFirstChild("Left Foot") or Character:FindFirstChild("Left Leg")
            local rf = Character:FindFirstChild("Right Foot") or Character:FindFirstChild("Right Leg")

            if lf then 
                firetouchinterest(lf, ball, 0) 
                firetouchinterest(lf, ball, 1) 
            end
            if rf then 
                firetouchinterest(rf, ball, 0) 
                firetouchinterest(rf, ball, 1) 
            end

            for _, part in ipairs(Character:GetChildren()) do
                if part:IsA("BasePart") then
                    firetouchinterest(part, ball, 0)
                    firetouchinterest(part, ball, 1)
                end
            end
        end
    end

    if TPBolaEnabled and ball and ball.Parent then
        pcall(function()
            local playerPos = RootPart.Position
            local ballPos = ball.Position
            local diff = (ballPos - playerPos).Magnitude
            if diff > 5 then
                local direcao = (ballPos - playerPos).Unit
                local posFinal = ballPos - (direcao * 2.5) + Vector3.new(0, 2, 0)
                RootPart.CFrame = CFrame.new(posFinal)
            end
        end
    end
end)

